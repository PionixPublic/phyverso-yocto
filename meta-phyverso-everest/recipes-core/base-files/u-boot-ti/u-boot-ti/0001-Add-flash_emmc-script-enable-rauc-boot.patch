From c787ac4350b2c6fc3901464381cf2d5b9dff1db8 Mon Sep 17 00:00:00 2001
From: Cornelius Claussen <cc@pionix.de>
Date: Thu, 28 Mar 2024 11:07:30 +0100
Subject: [PATCH] Add flash_emmc script, enable rauc boot

Signed-off-by: Cornelius Claussen <cc@pionix.de>
---
 board/phytec/phycore_am62x/phycore_am62x.env |  1 +
 include/environment/phytec/flash_emmc.env    | 29 ++++++++++++++++++++
 include/environment/phytec/rauc.env          |  2 +-
 3 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100644 include/environment/phytec/flash_emmc.env

diff --git a/board/phytec/phycore_am62x/phycore_am62x.env b/board/phytec/phycore_am62x/phycore_am62x.env
index e4b8aa51ed..47f759a8d9 100644
--- a/board/phytec/phycore_am62x/phycore_am62x.env
+++ b/board/phytec/phycore_am62x/phycore_am62x.env
@@ -1,6 +1,7 @@
 #include <environment/ti/ti_armv7_common.env>
 #include <environment/ti/k3_dfu.env>
 #include <environment/phytec/rauc.env>
+#include <environment/phytec/flash_emmc.env>
 
 name_kern=Image
 console=ttyS2,115200n8
diff --git a/include/environment/phytec/flash_emmc.env b/include/environment/phytec/flash_emmc.env
new file mode 100644
index 0000000000..ac2fbaac0d
--- /dev/null
+++ b/include/environment/phytec/flash_emmc.env
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+
+wic_image=phyverso-basecamp-image-am62-ksp0728-1.wic
+
+flash_emmc=
+	test -n ${BOOT_ORDER} || setenv BOOT_ORDER system0 system1;
+	test -n ${BOOT_system0_LEFT} || setenv BOOT_system0_LEFT 3;
+	ext4size usb 0:1 ${wic_image};
+	setenv counter 0;
+	setenv offset 0;
+	setenv block_number 0x2000;
+	setexpr bytes_left ${filesize} - ${offset};
+	echo start: ${bytes_left};
+	while itest ${bytes_left}  > 0;
+        do
+		echo rest: ${bytes_left};
+		setexpr copy_bytes ${block_number} * 0x200
+		ext4load usb 0:1 0xa0000000 ${wic_image} ${copy_bytes} ${offset};
+		mmc write 0xa0000000 ${counter} ${block_number};
+		setexpr counter ${counter} + ${block_number};
+		setexpr offset ${offset} + ${copy_bytes};
+		echo ${counter};
+		echo ${offset};
+		if itest ${bytes_left} < ${copy_bytes}; then
+			setenv bytes_left 0;
+		else
+			setexpr bytes_left ${bytes_left} - ${copy_bytes};
+		fi;
+	done;
diff --git a/include/environment/phytec/rauc.env b/include/environment/phytec/rauc.env
index 651a4592b1..24667f3905 100644
--- a/include/environment/phytec/rauc.env
+++ b/include/environment/phytec/rauc.env
@@ -1,6 +1,6 @@
 /* SPDX-License-Identifier: GPL-2.0+ */
 
-doraucboot=0
+doraucboot=1
 
 raucdev=0
 raucslot=system0
