[Unit]
Description=cg5317 Host Loading Service
After=cg5317-bringup.service
Before=everest.service

[Service]
User=root
Group=root
ExecStart=/root/examples/host_loading_service/host_loading_service -f /usr/lib/firmware/FW.bin -c /usr/lib/firmware/spi_cco_config.bin -i 0 -s seth1
ExecStart=/root/examples/host_loading_service/host_loading_service -f /usr/lib/firmware/FW.bin -c /usr/lib/firmware/spi_cco_config.bin -i 0 -s seth0
ExecStart=/etc/systemd/system/check_modems_up.sh

Type=oneshot
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
